# TRACEPOINT - Environment Configuration Template
APP_ENV=development
APP_SECRET_KEY=replace-with-local-secret
DATABASE_URL=sqlite:///./tracepoint.db
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=50
DEFAULT_TIMEZONE=Asia/Kolkata

# Optional AI Provider (System includes built-in deterministic pattern orchestrator)
LLM_PROVIDER=mock
LLM_API_KEY=replace-me
LLM_MODEL=gpt-4o-mini

# Web Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
